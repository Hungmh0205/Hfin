<Window x:Class="AccountingOcrTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Accounting OCR - Batch Processing" Height="800" Width="1200" WindowState="Maximized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Background="#f3f4f6" Padding="10" BorderBrush="#e5e7eb" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Cài đặt API Key" Padding="10,5" Click="SettingsBtn_Click"/>
                    <Button Content="Thêm Ảnh" Margin="10,0,0,0" Padding="10,5" Click="AddImagesBtn_Click"/>
                    <TextBlock Text="Model:" VerticalAlignment="Center" Margin="15,0,5,0" FontWeight="Bold"/>
                    <ComboBox x:Name="ModelSelector" Width="200" SelectedIndex="0" VerticalContentAlignment="Center" Padding="5,0">
                        <ComboBoxItem Content="gemini-3.5-flash"/>
                        <ComboBoxItem Content="gemini-3-flash-preview"/>
                    </ComboBox>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="ProgressText" Text="0/0" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed" FontWeight="Bold" Foreground="#6366f1"/>
                    <ProgressBar x:Name="ProgressBar" Width="150" Height="18" Margin="0,0,10,0" Visibility="Collapsed" Foreground="#10b981"/>
                    <Button x:Name="CancelBtn" Content="⏹ Hủy" Padding="10,5" Background="#ef4444" Foreground="White" FontWeight="Bold" Click="CancelBtn_Click" Visibility="Collapsed" Margin="0,0,10,0"/>
                    <Button x:Name="StartBtn" Content="▶ Bắt đầu xử lý" Padding="15,5" Background="#10b981" Foreground="White" FontWeight="Bold" Click="StartBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar -->
            <Grid Background="#f9fafb">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="SearchBox" Margin="10" Padding="5" TextChanged="SearchBox_TextChanged" Text="🔍 Tìm kiếm..."/>
                <ListBox x:Name="ItemsListBox" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="5" SelectionChanged="ItemsListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" Margin="0,0,0,5" Background="White" BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding StatusIcon}" Width="20" FontWeight="Bold" Foreground="{Binding StatusColor}"/>
                                    <TextBlock Text="{Binding SmartName}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" Width="230"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="#e5e7eb"/>

            <!-- Right Preview Area -->
            <Grid Grid.Column="2" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Image Preview -->
                <Border BorderBrush="#e5e7eb" BorderThickness="1" Background="#f3f4f6">
                    <Image x:Name="PreviewImage" Stretch="Uniform"/>
                </Border>

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="Transparent"/>

                <!-- Right: OCR Data -->
                <Grid Grid.Column="2" Margin="10,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel>
                        <TextBlock Text="Thông tin chung" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Ngày giao" Foreground="Gray"/>
                                <TextBox x:Name="NgayGiaoText" FontWeight="Bold" FontSize="14" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Khách hàng" Foreground="Gray"/>
                                <TextBox x:Name="KhachHangText" FontWeight="Bold" FontSize="14" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Điểm giao" Foreground="Gray"/>
                                <TextBox x:Name="DiemGiaoText" FontWeight="Bold" FontSize="14" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
                            </StackPanel>
                        </Grid>
                        
                        <TextBlock Text="Chi tiết hàng hóa" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                    </StackPanel>

                    <DataGrid x:Name="ProductsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" AlternatingRowBackground="#f9fafb" RowHeight="30" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên Hàng" Binding="{Binding ten_hang}" Width="*"/>
                            <DataGridTextColumn Header="SL Xuất" Binding="{Binding sl_xuat}" Width="80"/>
                            <DataGridTextColumn Header="SL Nhận" Binding="{Binding sl_nhan}" Width="80"/>
                            <DataGridTextColumn Header="SL Hỏng" Binding="{Binding sl_hong}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="Red"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>

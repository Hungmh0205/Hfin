<Window x:Class="AccountingOcrTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AccountingOcrTest"
        Title="Accounting OCR - Batch Processing" Height="800" Width="1200" WindowState="Maximized" Icon="logo.png">
    <Window.Resources>
        <local:MatchScoreToBrushConverter x:Key="MatchScoreToBrushConverter"/>
    </Window.Resources>
    <Grid>
        <TabControl x:Name="MainTabControl">
        <!-- Tab 1: Trang chủ -->
        <TabItem Header="Trang chủ" FontSize="14" FontWeight="SemiBold">
            <Grid Background="#f3f4f6" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top bar for actions on Homepage -->
                <Border Background="White" CornerRadius="5" Padding="10" Margin="0,0,0,10" BorderBrush="#e5e7eb" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Content="📁 Nạp File Mới" Padding="15,6" Background="#0078D7" Foreground="White" BorderThickness="0" Cursor="Hand" Click="HomeImportFile_Click" FontWeight="Bold"/>
                        
                        <Button Content="🗑️ Xóa đã chọn" Grid.Column="1" Margin="10,0,0,0" Padding="15,6" Background="#ef4444" Foreground="White" BorderThickness="0" Cursor="Hand" Click="HomeDeleteSelected_Click" FontWeight="Bold"/>

                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="Gray" FontStyle="Italic" Text="* Danh sách tệp Excel đã cấu hình. Chọn tệp và bấm 'Nạp' để hiển thị nhanh." HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- Configuration List Grid Area -->
                <Border Grid.Row="1" Background="White" CornerRadius="5" Padding="10" BorderBrush="#e5e7eb" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="Danh sách tệp cấu hình" FontWeight="Bold" FontSize="16" Foreground="#1e293b" Margin="0,0,0,10"/>
                        
                        <DataGrid x:Name="HomeConfigsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" AlternatingRowBackground="#f9fafb" RowHeight="35" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Background" Value="#e6f4ea"/>
                                            <Setter Property="Foreground" Value="#137333"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tên File" Binding="{Binding FileName}" Width="200" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Đường dẫn gốc" Binding="{Binding OriginalPath}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Sheet Tham chiếu" Binding="{Binding RefSheet}" Width="150" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Sheet Bán hàng" Binding="{Binding SalesSheet}" Width="150" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="110" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding StatusColor}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Ngày thêm" Binding="{Binding DateAdded, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Width="150" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Hành động" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="⚡ Nạp" IsEnabled="{Binding CanLoad}" Padding="10,2" Margin="0,0,5,0" Background="#10b981" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="HomeLoadConfigRow_Click" Tag="{Binding}"/>
                                                <Button Content="🗑️ Xóa" Padding="10,2" Background="#ef4444" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="HomeDeleteConfigRow_Click" Tag="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="Xử lý OCR" FontSize="14" FontWeight="SemiBold">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Bar -->
                <Border Background="#f3f4f6" Padding="10" BorderBrush="#e5e7eb" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SettingsBtn" Content="Cài đặt API Key" Padding="10,5" Click="SettingsBtn_Click"/>
                            <Button x:Name="AddImagesBtn" Content="Thêm Ảnh" Margin="10,0,0,0" Padding="10,5" Click="AddImagesBtn_Click"/>
                            <TextBlock Text="Người giao:" VerticalAlignment="Center" Margin="15,0,5,0" FontWeight="Bold"/>
                            <ComboBox x:Name="ShipperSelector" Width="150" IsEditable="True" VerticalContentAlignment="Center" Padding="5,0"/>
                            <TextBlock Text="Model:" VerticalAlignment="Center" Margin="15,0,5,0" FontWeight="Bold"/>
                            <ComboBox x:Name="ModelSelector" Width="200" SelectedIndex="0" VerticalContentAlignment="Center" Padding="5,0">
                                <ComboBoxItem Content="gemini-3.5-flash"/>
                                <ComboBoxItem Content="gemini-3-flash-preview"/>
                            </ComboBox>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                            <Button x:Name="NewSessionBtn" Content="🔄 Tạo phiên mới" Padding="10,5" Background="#f97316" Foreground="White" FontWeight="Bold" Click="NewSessionBtn_Click" Margin="0,0,10,0"/>
                            <TextBlock x:Name="ProgressText" Text="0/0" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed" FontWeight="Bold" Foreground="#6366f1"/>
                            <ProgressBar x:Name="ProgressBar" Width="150" Height="18" Margin="0,0,10,0" Visibility="Collapsed" Foreground="#10b981"/>
                            <Button x:Name="CancelBtn" Content="⏹ Hủy" Padding="10,5" Background="#ef4444" Foreground="White" FontWeight="Bold" Click="CancelBtn_Click" Visibility="Collapsed" Margin="0,0,10,0"/>
                            <Button x:Name="StartBtn" Content="▶ Bắt đầu xử lý" Padding="15,5" Background="#10b981" Foreground="White" FontWeight="Bold" Click="StartBtn_Click"/>
                            <Button x:Name="ContinueBtn" Content="Tiếp tục ➔" Padding="15,5" Background="#16a34a" Foreground="White" FontWeight="Bold" Click="ContinueBtn_Click" Visibility="Collapsed" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Sidebar -->
                    <Grid Background="#f9fafb">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="SearchBox" Margin="10" Padding="5" TextChanged="SearchBox_TextChanged" Text="🔍 Tìm kiếm..."/>
                        <ListBox x:Name="ItemsListBox" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="5" SelectionChanged="ItemsListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" Margin="0,0,0,5" Background="White" BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding StatusIcon}" Width="20" FontWeight="Bold" Foreground="{Binding StatusColor}"/>
                                            <TextBlock Text="{Binding SmartName}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" Width="230"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="#e5e7eb" Cursor="SizeWE" ResizeBehavior="PreviousAndNext"/>

                    <!-- Right Preview Area -->
                    <Grid Grid.Column="2" Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Image Preview with Zoom and Pan -->
                        <Border BorderBrush="#e5e7eb" BorderThickness="1" Background="#f3f4f6" ClipToBounds="True" MouseWheel="PreviewImage_MouseWheel" MouseDown="PreviewImage_MouseDown" MouseUp="PreviewImage_MouseUp" MouseMove="PreviewImage_MouseMove">
                            <Grid x:Name="ImageParentGrid" ClipToBounds="True">
                                <Image x:Name="PreviewImage" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="ImageScaleTransform" ScaleX="1" ScaleY="1"/>
                                            <TranslateTransform x:Name="ImageTranslateTransform" X="0" Y="0"/>
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="#d1d5db" Cursor="SizeWE" ResizeBehavior="PreviousAndNext"/>

                        <!-- Right: OCR Data -->
                        <Grid Grid.Column="2" Margin="10,0,0,0" DataContext="{Binding ElementName=ItemsListBox, Path=SelectedItem}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel>
                                <!-- Error Banner -->
                                <Border x:Name="ErrorBanner" Background="#fee2e2" BorderBrush="#fca5a5" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Error">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚠️ " FontSize="16" FontWeight="Bold" Foreground="#dc2626" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#991b1b" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Thông tin chung" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Ngày giao" Foreground="Gray"/>
                                        <TextBox x:Name="NgayGiaoText" Text="{Binding Data.ngay_giao, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" FontWeight="Bold" FontSize="14" Padding="4" BorderThickness="1" BorderBrush="#e5e7eb"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Khách hàng" Foreground="Gray"/>
                                        <TextBox x:Name="KhachHangText" Text="{Binding Data.khach_hang, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" FontWeight="Bold" FontSize="14" Padding="4" BorderThickness="1" BorderBrush="#e5e7eb"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Điểm giao" Foreground="Gray"/>
                                        <TextBox x:Name="DiemGiaoText" Text="{Binding Data.diem_giao, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" FontWeight="Bold" FontSize="14" Padding="4" BorderThickness="1" BorderBrush="#e5e7eb"/>
                                    </StackPanel>
                                </Grid>
                                
                                <TextBlock Text="Chi tiết hàng hóa" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                            </StackPanel>
 
                            <DataGrid x:Name="ProductsGrid" Grid.Row="1" ItemsSource="{Binding Data.danh_sach_hang_hoa}" AutoGenerateColumns="False" CanUserAddRows="False" AlternatingRowBackground="#f9fafb" RowHeight="30" GridLinesVisibility="Horizontal" HeadersVisibility="Column" CellEditEnding="ProductsGrid_CellEditEnding">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tên Hàng" Binding="{Binding ten_hang, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="*"/>
                                    <DataGridTextColumn Header="SL Xuất" Binding="{Binding sl_xuat, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="80"/>
                                    <DataGridTextColumn Header="SL Nhận" Binding="{Binding sl_nhan, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="80"/>
                                    <DataGridTextColumn Header="SL Hỏng" Binding="{Binding sl_hong, Mode=OneWay}" IsReadOnly="True" Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="Red"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </TabItem>

        <!-- Tab: Xem trước & Đối soát -->
        <TabItem x:Name="PreviewTab" Header="Xem trước &amp; Đối soát" FontSize="14" FontWeight="SemiBold">
            <Grid Background="#f3f4f6" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Action Bar -->
                <Border Background="White" CornerRadius="5" Padding="10" Margin="0,0,0,10" BorderBrush="#e5e7eb" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button x:Name="ReloadPreviewBtn" Content="🔄 Tải lại dữ liệu" Padding="15,6" Background="#f3f4f6" Foreground="#374151" BorderBrush="#d1d5db" BorderThickness="1" Cursor="Hand" Click="ReloadPreviewBtn_Click" FontWeight="SemiBold"/>
                        
                        <Button x:Name="DeletePreviewSelectedBtn" Content="🗑️ Xóa dòng chọn" Grid.Column="1" Margin="10,0,0,0" Padding="15,6" Background="#ef4444" Foreground="White" BorderThickness="0" Cursor="Hand" Click="DeletePreviewSelected_Click" FontWeight="Bold"/>

                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button x:Name="CommitToExcelBtn" Content="💾 Xác nhận &amp; Ghi sổ Excel" Padding="20,6" Background="#16a34a" Foreground="White" BorderThickness="0" Cursor="Hand" Click="CommitToExcelBtn_Click" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Data Preview DataGrid -->
                <Border Grid.Row="1" Background="White" CornerRadius="5" Padding="10" BorderBrush="#e5e7eb" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Danh sách chi tiết mặt hàng đang chờ ghi sổ (Staging)" FontWeight="Bold" FontSize="16" Foreground="#1e293b" VerticalAlignment="Center"/>
                            <CheckBox x:Name="SelectAllPreviewChk" Content="Chọn tất cả" Grid.Column="1" FontWeight="Bold" VerticalAlignment="Center" Click="SelectAllPreviewChk_Click" IsChecked="True"/>
                        </Grid>

                        <DataGrid x:Name="PreviewDataGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" AlternatingRowBackground="#f9fafb" RowHeight="35" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" CellEditEnding="PreviewDataGrid_CellEditEnding">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="{Binding MatchScore, Converter={StaticResource MatchScoreToBrushConverter}}"/>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Chọn" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="50"/>
                                <DataGridTextColumn Header="Ngày giao" Binding="{Binding NgayGiao, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="110"/>
                                <DataGridTextColumn Header="Khách hàng" Binding="{Binding KhachHang, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="130"/>
                                <DataGridTextColumn Header="Điểm giao" Binding="{Binding DiemGiao, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="180"/>
                                <DataGridTextColumn Header="Người giao" Binding="{Binding NguoiGiao, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="120"/>
                                <DataGridTextColumn Header="Tên gốc (Hóa đơn)" Binding="{Binding TenHangGoc}" IsReadOnly="True" Width="200"/>
                                <DataGridTextColumn Header="Tên khớp chuẩn (Tham chiếu)" Binding="{Binding TenHangKhop, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="200"/>
                                <DataGridTextColumn Header="Mã hst" Binding="{Binding Hst, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="100"/>
                                <DataGridTextColumn Header="ĐVT" Binding="{Binding DonVi}" IsReadOnly="True" Width="80"/>
                                <DataGridTextColumn Header="SL Xuất" Binding="{Binding SlXuat, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="80"/>
                                <DataGridTextColumn Header="SL Nhận" Binding="{Binding SlNhan, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="80"/>
                                <DataGridTextColumn Header="SL Hỏng" Binding="{Binding SlHong}" IsReadOnly="True" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="Red"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <!-- Tab 2: Reference Excel -->
        <TabItem Header="Tham chiếu" FontSize="14" FontWeight="SemiBold">
            <Grid Background="#f3f4f6" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top bar for Reference Excel Loading -->
                <Border Background="White" CornerRadius="5" Padding="10" Margin="0,0,0,10" BorderBrush="#e5e7eb" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Content="📁 Nạp File Excel" Padding="15,6" Background="#0078D7" Foreground="White" BorderThickness="0" Cursor="Hand" Click="LoadRefExcel_Click" FontWeight="Bold"/>
                        
                        <Button x:Name="ChangeSheetsBtn" Grid.Column="1" Content="⚙️ Chọn Sheet" Margin="10,0,0,0" Padding="12,6" Background="#4b5563" Foreground="White" BorderThickness="0" Cursor="Hand" Click="ChangeSheets_Click" FontWeight="Bold" IsEnabled="False"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Sheet Tham chiếu: " Foreground="#475569"/>
                            <TextBlock x:Name="SelectedRefSheetText" Text="Chưa chọn" FontWeight="Bold" Foreground="#1e293b" Margin="0,0,20,0"/>
                            
                            <TextBlock Text="Sheet Bán hàng: " Foreground="#475569"/>
                            <TextBlock x:Name="SelectedSalesSheetText" Text="Chưa chọn" FontWeight="Bold" Foreground="#1e293b"/>
                        </StackPanel>
                        
                        <Button x:Name="ExportExcelBtn" Grid.Column="3" Content="📤 Xuất File Excel" Margin="15,0,0,0" Padding="15,6" Background="#16a34a" Foreground="White" BorderThickness="0" Cursor="Hand" Click="ExportExcelBtn_Click" FontWeight="Bold"/>
                        
                        <TextBlock x:Name="RefFilePathText" Grid.Column="4" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="Gray" FontStyle="Italic" Text="Chưa chọn file Excel tham chiếu." TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- Nested Tab Control for Reference & Sales Sheets -->
                <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                    <TabItem Header="Sản phẩm tham chiếu" FontSize="13" Padding="15,6" FontWeight="SemiBold">
                        <Border Background="White" CornerRadius="0,0,5,5" Padding="10" BorderBrush="#e5e7eb" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Text="Danh sách sản phẩm tiêu chuẩn (Đã lọc bỏ các mặt hàng tính theo Kg)" FontWeight="Bold" FontSize="14" Foreground="#333" Margin="0,0,0,10"/>
                                
                                <DataGrid x:Name="RefDataGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" AlternatingRowBackground="#f9fafb" RowHeight="30" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Viết tắt" Binding="{Binding VietTat}" Width="150"/>
                                        <DataGridTextColumn Header="Tên hàng" Binding="{Binding TenHang}" Width="*"/>
                                        <DataGridTextColumn Header="Đơn vị tính" Binding="{Binding DonViTinh}" Width="150"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </TabItem>
                    <TabItem Header="Dữ liệu bán hàng" FontSize="13" Padding="15,6" FontWeight="SemiBold">
                        <Border Background="White" CornerRadius="0,0,5,5" Padding="10" BorderBrush="#e5e7eb" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Text="Dữ liệu thô từ Sheet Bán hàng (Có gì hiển thị nấy, tối ưu dữ liệu lớn)" FontWeight="Bold" FontSize="14" Foreground="#333" Margin="0,0,0,10"/>
                                
                                <DataGrid x:Name="SalesDataGrid" Grid.Row="1" AutoGenerateColumns="True" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" 
                                          AlternatingRowBackground="#f9fafb" RowHeight="30" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                          VirtualizingPanel.CacheLengthUnit="Item" VirtualizingPanel.CacheLength="20,20"/>
                            </Grid>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </TabItem>
    </TabControl>

    <!-- Window-level Loading Overlay -->
    <Border x:Name="RefLoadingOverlay" Background="#90FFFFFF" Visibility="Collapsed" Panel.ZIndex="100">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" Margin="20" Padding="30" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <StackPanel>
                <ProgressBar IsIndeterminate="True" Width="200" Height="10" Margin="0,0,0,15"/>
                <TextBlock x:Name="RefLoadingText" Text="Đang tải dữ liệu..." FontSize="16" FontWeight="SemiBold" Foreground="#333" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Border>
</Grid>
</Window>

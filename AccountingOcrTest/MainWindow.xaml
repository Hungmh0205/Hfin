<Window x:Class="AccountingOcrTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kiểm thử OCR Kế toán - Gemini 3.5 Flash" Height="700" Width="1000" Background="#F8F9FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Configuration -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Gemini API Key:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
            <TextBox x:Name="ApiKeyTextBox" Width="350" Padding="5" VerticalContentAlignment="Center"/>
            <Button x:Name="SelectImageBtn" Content="1. Chọn ảnh hóa đơn" Padding="15,5" Margin="20,0,0,0" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="SelectImageBtn_Click"/>
            <Button x:Name="ExtractBtn" Content="2. Bắt đầu trích xuất" Padding="15,5" Margin="10,0,0,0" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="ExtractBtn_Click" IsEnabled="False"/>
        </StackPanel>

        <!-- Status & Path -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock x:Name="FilePathText" Text="Chưa chọn ảnh nào" FontStyle="Italic" Foreground="Gray" Margin="0,0,0,10"/>
            <TextBlock x:Name="StatusText" Text="" FontWeight="Bold" Foreground="#3B82F6"/>
        </StackPanel>

        <!-- Extracted General Info -->
        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Ngày giao" Foreground="Gray" FontSize="11" FontWeight="Bold" TextOptions.TextFormattingMode="Display"/>
                    <TextBlock x:Name="NgayGiaoText" Text="-" FontSize="18" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="5,0,5,0">
                <StackPanel>
                    <TextBlock Text="Khách hàng" Foreground="Gray" FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="KhachHangText" Text="-" FontSize="18" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Điểm giao" Foreground="Gray" FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="DiemGiaoText" Text="-" FontSize="18" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- DataGrid for Products -->
        <DataGrid x:Name="ProductsGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" 
                  Background="White" BorderBrush="#E2E8F0" BorderThickness="1" RowBackground="White" AlternatingRowBackground="#F8FAFC">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tên Hàng" Binding="{Binding ten_hang}" Width="*"/>
                <DataGridTextColumn Header="SL Xuất" Binding="{Binding sl_xuat}" Width="100"/>
                <DataGridTextColumn Header="SL Nhận" Binding="{Binding sl_nhan}" Width="100"/>
                <DataGridTextColumn Header="SL Hỏng (Xuất - Nhận)" Binding="{Binding sl_hong}" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Red"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>

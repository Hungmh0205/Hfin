<Window x:Class="AccountingOcrTest.ApiKeyManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý API Key" Height="400" Width="500" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="NewKeyTextBox" Width="300" Margin="0,0,10,0" Padding="5" />
            <Button x:Name="AddKeyBtn" Content="Thêm Key" Width="70" Click="AddKeyBtn_Click"/>
            <Button x:Name="ImportBtn" Content="Import .txt" Width="80" Margin="10,0,0,0" Click="ImportBtn_Click"/>
        </StackPanel>

        <ListView x:Name="KeysListView" Grid.Row="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Status" Width="50">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Width="12" Height="12" Fill="{Binding StatusColor}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="API Key" Width="250" DisplayMemberBinding="{Binding Key}"/>
                    <GridViewColumn Header="Req/Min" Width="80" DisplayMemberBinding="{Binding RequestsInLastMinute}"/>
                    <GridViewColumn Header="Action" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Xóa" Click="DeleteKeyBtn_Click" Tag="{Binding}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <Button x:Name="CloseBtn" Grid.Row="2" Content="Đóng" Width="100" HorizontalAlignment="Right" Margin="0,10,0,0" Padding="5" Click="CloseBtn_Click"/>
    </Grid>
</Window>
